(ns app.pages.resume
  (:require app.layouts.main))

(defn white []
  [:div
   [:h1 {:class "display-2"} "Resume"]
   [:p [:a {:href "/"} "home"] " / resume"]])

(defn column [& body]
  [:div {:class "col-lg-4"} (apply list body)])

(defn group [title & units]
  [:div {:class "black-group"}
   [:h2 {:class "black-group-title"} title]
   (apply list units)])

(defn unit
  [&
   [{:title title
     :subtitle subtitle
     :intro intro
     :body body}]]
  [:div {:class "unit pb-4"}
   (if-not (nil? title)
     [:div {:class "unit-title"}
      title
      (if-not (nil? subtitle) [:br])
      (if-not (nil? subtitle) [:span {:class "unit-subtitle"} " " subtitle])])
   (if-not (nil? intro) [:div {:class "unit-intro"} intro])
   (if-not (nil? body) [:div {:class "unit-body"} body])])

(def left-column
  (column
   (group
    "Tech Stack"
    (unit
     {:title "TypeScript"
      :subtitle "Types for JavaScript"
      :intro "Can bring huge benefits over JavaScript if properly configured and used, otherwise straight up lies."})
    (unit
     {:title "Effect"
      :subtitle "A powerful TypeScript library"
      :intro "This tool enables TypeScript developers to easily create complex, synchronous, and asynchronous programs."})
    (unit
     {:title "JavaScript Frameworks"
      :subtitle "Next.js, NestJS, Deno Fresh"
      :intro "Full-stack React/Preact frameworks that I have a lot of experience with."})
    (unit
     {:title "JavaScript UI Libraries"
      :subtitle "React, Vue, Preact"
      :intro "I prefer Preact over React, React over Vue, but I think that Vue has some good things going for it."})
    (unit
     {:title "Mobile App Development"
      :subtitle "React Native"
      :intro "I have built and published a mobile application for iPhone and Android devices using React Native."})
    (unit
     {:title "CSS Tooling"
      :subtitle "Tailwind, Bootstrap, SCSS/Saas, CSS"
      :intro "The arrival of Tailwind on the scene changed things for me greatly. I can easily create a design which looks consistent and the colors match."})
    (unit
     {:title "JavaScript Tooling"
      :subtitle "Nx, Turborepo, PNPM, Deno, Yarn, Prettier, Biome, Oxlint, NPM, Node, ESLint"
      :intro "Tooling configuration can make or break a project. I know how to setup a project from the ground up."})
    (unit
     {:title "Laravel"
      :subtitle "The best batteries-included PHP framework"
      :intro "Started using Laravel when it was v3, now still using it with v13. It has its ups and downs, but it works."})
    (unit
     {:title "PHP"
      :subtitle "Love it or hate it, but it just works"
      :intro "I have been using PHP for a long time now. Most of my career was built using it. I can only recommend it."})
    (unit
     {:title "Lisp family of languages"
      :subtitle "Clojure, ClojureScript, Phel"
      :intro "After trying multiple languages I have found that I really like the simplicity of Lisp languages."})
    (unit
     {:title "Statically typed functional languages"
      :subtitle "Scala, Scala.js, F#"
      :intro "I have built two websites using Scala/Scala.js, and one internal project with F#."}))))

(def middle-column
  (column
   (group
    "Devops"
    (unit {:title "Servers"
           :subtitle "Linux, BSD"
           :intro "Can install, configure, and maintain software for server environments running popular Linux distributions or BSD-based operating systems."})
    (unit {:title "Containers"
           :subtitle "Docker, Podman"
           :intro "Can containerize applications for local development or production/staging deployment."})
    (unit {:title "CI/CD"
           :subtitle "GitHub, BitBucket, GitLab"
           :intro "Can setup and maintain pipelines for testing and deploying applications."})
    (unit {:title "Ansible"
           :subtitle "Manage and maintain system configuration"
           :intro "Can use Ansible to manage single or multiple servers, and deploy applications."}))
   (group
    "Graphic Design"
    (unit
     {:title "Raster images"
      :subtitle "GIMP, Krita, Affinity, PixiEditor"
      :body "Can create and edit raster images using a variety of tools, including tablet hand-drawing."})
    (unit
     {:title "Vector images"
      :subtitle "Inkscape, Affinity"
      :body "Can create and edit print designs, logos, and icons, from rough concepts to polished, usable files."})
    (unit
     {:title "Publication software"
      :subtitle "Affinity"
      :body "Can create books, magazines, business cards, and marketing materials ready for print."}))
   (group
    "Awards"
    (unit
     {:title [:a {:href "/2008/12/31/best-student-in-class"} "Best student in class"]
      :intro "2008"
      :subtitle "VERN' University"}))))

(def right-column
  (column
   (group
    "Work Experience"
    (unit
     {:title [:a {:target "_blank" :href "https://govisit.hr"} "Go Visit ltd."]
      :subtitle "2017 to present"
      :intro "Full Stack Programmer"
      :body "Built a tourist portal for the island of Murter. Consulted for multiple international startups and partnered with local software agencies to deliver products used by millions of users."})
    (unit
     {:title "RTL Croatia"
      :subtitle "2021 to 2023"
      :intro "Full Stack Programmer"
      :body "Worked in a team as a full stack developer for RTL media portals building applications that scale."})
    (unit
     {:title [:a {:target "_blank" :href "https://laravelista.com"} "Laravelista"]
      :subtitle "2016 to 2023"
      :intro "Full Stack Programmer"
      :body "Specialized in building web applications using Laravel, and mobile applications with React Native & React."})
    (unit
     {:title "Freelance"
      :subtitle "2008 to 2016"
      :intro "Full Stack Programmer"
      :body "Created content management systems for real estates agencies. Created websites for small businesses."}))
   (group
    "Formal Education"
    (unit
     {:title "Master of Science (MSc) in IT Management (MSc)"
      :intro "2011 to 2017"
      :subtitle "VERN' University"})
    (unit
     {:title "Bachelor's degree (baccalaureus) in Business Informatics (bacc. inf.)"
      :intro "2008 to 2011"
      :subtitle "VERN' University"})
    (unit
     {:title "Sales Specialist"
      :intro "2004 to 2008"
      :subtitle "Economics School Šibenik"}))
   (group
    "Languages"
    (unit {:title "Croatian" :subtitle "Native"})
    (unit {:title "English" :subtitle "Fluent"})
    (unit {:title "Italian" :subtitle "Very basic"}))))

(defn black []
  [:div {:class "row"}
   left-column
   middle-column
   right-column])

(defn render [request]
  {:status 200
   :body (main/render
          request
          {:title "Resume| Mario Bašić"
           :meta-description "Your can view my resume on this page."
           :canonical-url (:path (:uri request))
           :white (white)
           :black (black)})})
